NODE_ENV=production
HOST=0.0.0.0
PORT=3000

# Generate a unique random secret of at least 32 characters.
JWT_SECRET=replace-this-with-a-long-random-secret-before-starting

# Comma-separated exact web origins. Native clients without an Origin header are allowed.
# Production startup rejects an empty list or wildcard.
CORS_ORIGIN=https://your-approved-web-origin.example

# Comma-separated HTTPS RSS feed URLs. Leave empty until feed sources are reviewed.
ANIME_NEWS_RSS_URLS=
ANIME_NEWS_RSS_URL=

# Watchium bridge. Keep these values on the backend only; never add them to the APK.
WATCHIUM_SERVER_URL=
WATCHIUM_API_TOKEN=
# Exact verified provider identities, comma-separated, e.g. anilist:123456
WATCHIUM_ALLOWED_IDENTITIES=
